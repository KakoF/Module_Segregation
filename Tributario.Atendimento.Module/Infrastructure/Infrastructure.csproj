    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PackageId>Tributario.Atendimento.Infrastructure</PackageId>
    <Version>2.0.0</Version>
    <Authors>Marcos</Authors>
    <Description>Camada de infrastructure do módulo Atendimento</Description>
    <AssemblyName>Tributario.Atendimento.Module.Infrastructure</AssemblyName>
  </PropertyGroup>

<ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="8.0.30" />
